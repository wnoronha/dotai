#!/bin/sh
# pre-push hook: refuse to push refs carrying wip: handoff commits.
# Session handoffs are wip: commit bodies (goal, decisions, verified, next).
# They stay local; rework them into ordered commits before opening a PR.
# Install: cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Bypass (not recommended): git push --no-verify.

zero="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  # Fail-open by design: on rev-list errors the range is empty and the push proceeds.
  wip=$(git rev-list --format='%H %s' -i --grep='^wip[(: ]' $range 2>/dev/null | grep -i '^[^ ]* wip[(: ]' || true)
  if [ -n "$wip" ]; then
    echo "Refusing push of $local_ref: rework wip: commits first." >&2
    echo "$wip" >&2
    blocked=1
  fi
done

exit $blocked
